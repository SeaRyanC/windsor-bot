{
  "name": "windsor-bot",
  "version": "0.2.13",
  "description": "Self-hosted Discord bot automation for household list and todo printing",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc && node scripts/build-web.mjs",
    "clean": "node scripts/clean.mjs",
    "deploy": "git push origin 'refs/tags/v*:refs/tags/v*'",
    "dev": "node src/index.ts",
    "test": "node --test src/tests/*.test.ts",
    "generate-wordsearches": "node scripts/generate-wordsearches.mjs",
    "gen-image": "node scripts/generate-image.mjs"
  },
  "bin": {
    "windsor-bot": "dist/index.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SeaRyanC/windsor-bot.git"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/SeaRyanC/windsor-bot/issues"
  },
  "homepage": "https://github.com/SeaRyanC/windsor-bot#readme",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "discord.js": "^14.27.0",
    "esbuild": "^0.28.1",
    "escpos-buffer": "^4.1.0",
    "jimp": "^1.6.1",
    "openai": "^7.3.0",
    "pdfkit": "^0.19.1",
    "preact": "^10.29.7",
    "qrcode": "^1.5.4",
    "serialport": "^13.0.0"
  }
}
